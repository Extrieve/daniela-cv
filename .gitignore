# ============================================================
# .gitignore — Repositorio personal de Daniela Ciñera
# ============================================================
# Este repo es el sistema PERSONAL de Daniela, no un template
# público. Por eso INCLUYE su CV, perfil, tracker y reportes.
#
# ⚠️  Si publicás en GitHub, hacelo como repo PRIVADO.
#     Contiene email, teléfono, historial de aplicaciones.
# ============================================================

# Secrets — NUNCA commitear
.env
.env.local

# Update system internals (regenerables)
.update-dismissed
.update-lock

# Batch logs y estado intermedio
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv

# JDs descargados crudos
jds/*
!jds/.gitkeep

# Node / dependencias
node_modules/
package-lock.json
bun.lock

# OS / editor
.DS_Store
Thumbs.db
*.mov
*.mp4

# Generated / temporal
.resolved-prompt-*
*.zip
*.tmp
*.bak
output/*.html
new-urls.txt
daniela-urls.txt

# Claude Code local (settings personales del que abre el proyecto)
.claude/memory/
career-dashboard
